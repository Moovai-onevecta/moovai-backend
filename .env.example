# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to a service account JSON key (local dev only; use Application Default
# Credentials in production by leaving this unset).
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./secrets/service-account.json
FIREBASE_APP_NAME=moovai

# AI (OpenAI) - we call the hosted REST API directly, we do not host models
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo

# Search (SerpApi) - flight/hotel/destination search
SERPAPI_API_KEY=...

# meridian-ai - shared AI microservice used for itinerary generation and
# clarifying-question suggestion (see app/services/meridian_ai.py)
MERIDIAN_AI_URL=http://127.0.0.1:9000
MERIDIAN_AI_SERVICE_TOKEN=...
MERIDIAN_AI_TIMEOUT=90

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
