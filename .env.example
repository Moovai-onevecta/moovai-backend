# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to a service account JSON key (local dev only; use Application Default
# Credentials in production by leaving this unset).
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./secrets/service-account.json
FIREBASE_APP_NAME=moovai

# AI (OpenAI) - we call the hosted REST API directly, we do not host models
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo

# Search (SerpApi) - flight/hotel/destination search
SERPAPI_API_KEY=...

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
